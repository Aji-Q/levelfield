# Anthropic API key for the Stage A classifier (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Scoring model. Defaults to claude-opus-5 if unset.
SCORING_MODEL=claude-opus-5

# DreamDEX Shannon testnet (public, no key needed for read-only)
DREAMDEX_REST_URL=https://stg.api.dreamdex.io/v0
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312
