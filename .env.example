# Anthropic API key for the Stage A classifier (get one at console.anthropic.com).
# Read implicitly by `new Anthropic()` in packages/scoring/src/classify.ts.
ANTHROPIC_API_KEY=

# Scoring model. Defaults to claude-opus-5 if unset. Read by classify.ts.
SCORING_MODEL=claude-opus-5

# DreamDEX Shannon testnet indexer (GraphQL, public, no key needed for read-only).
# The URL is known-unstable (see FEEDBACK.md #4) — override it here if it moves.
# Read by packages/scoring/src/dreamdex.ts, scripts/probe-dreamdex.ts, scripts/sdk-crosscheck.ts.
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Somnia Shannon testnet RPC (public, no key needed for read-only). Read by
# scripts/deploy-registry.ts and scripts/publish-scores.ts.
RPC_URL=https://dream-rpc.somnia.network

# Only needed for `scripts/deploy-registry.ts --send` and `scripts/publish-scores.ts --send`
# (never needed for a dry run). Export a throwaway testnet private key, funded at
# https://testnet.somnia.network.
PRIVATE_KEY=

# ScoreRegistry contract address, printed by `scripts/deploy-registry.ts --send`. Required
# by scripts/publish-scores.ts (dry run previews calls against this address too).
REGISTRY_ADDRESS=
